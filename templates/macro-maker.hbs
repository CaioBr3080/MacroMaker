<div class="macro-maker-shell">
  <aside class="macro-maker-editor-sidebar">
    <header>
      <h2><i class="fas fa-wand-magic-sparkles"></i> Projetos</h2>
      <button type="button" data-action="new"><i class="fas fa-plus"></i> Novo</button>
    </header>

    <ol class="macro-maker-projects">
      {{#each projects}}
        <li class="{{#if active}}active{{/if}}">
          <button type="button" data-action="load" data-uuid="{{uuid}}" title="Abrir {{name}}">
            <img src="{{img}}" alt="">
            <span>{{name}}</span>
            {{#unless canEdit}}<i class="fas fa-eye" title="Somente leitura"></i>{{/unless}}
          </button>
        </li>
      {{else}}
        <li class="empty">Nenhum projeto ainda.</li>
      {{/each}}
    </ol>

    <nav class="macro-maker-step-outline" aria-label="Sequência de etapas">
      <h3>Sequência de etapas</h3>
      <ol>
        {{#each steps}}
          <li><button type="button" data-action="focus-step" data-index="{{index}}" title="Ir para etapa {{number}}"><span>{{number}}.</span> <span data-outline-label="{{index}}">{{displayLabel}}</span></button></li>
        {{else}}<li>Adicione etapas para organizar a sequência.</li>{{/each}}
      </ol>
    </nav>

    <section class="macro-maker-template-gallery">
      <h3><i class="fas fa-shapes"></i> Templates</h3>
      <div class="template-search"><input type="search" name="templateSearch" value="{{templateSearch}}" placeholder="Pesquisar"><button type="button" data-action="filter-templates"><i class="fas fa-search"></i></button></div>
      <select name="templateCategory" data-value="{{templateCategory}}"><option value="">Todas as categorias</option>{{#each templateCategories}}<option value="{{this}}">{{this}}</option>{{/each}}</select>
      <ol>
        {{#each templates}}
          <li><button type="button" data-action="apply-template" data-template-id="{{id}}"><span>{{name}}</span></button></li>
        {{else}}<li class="empty">Nenhum template encontrado.</li>{{/each}}
      </ol>
    </section>
  </aside>

  <main class="macro-maker-editor {{#unless canEdit}}read-only{{/unless}}">
    <header class="macro-maker-toolbar">
      <div>
        <h1>{{project.name}}</h1>
        <p>Projeto-fonte salvo nas flags do Macro.</p>
      </div>
      <div class="macro-maker-actions">
        <button type="button" data-action="import"><i class="fas fa-file-import"></i> Importar</button>
        <button type="button" data-action="export"><i class="fas fa-file-export"></i> Exportar</button>
        {{#if isGM}}<button type="button" data-action="save-template"><i class="fas fa-bookmark"></i> Template</button>{{/if}}
        {{#if isGM}}<button type="button" data-action="migrate-all"><i class="fas fa-database"></i> Migrar</button>{{/if}}
        <button type="button" data-action="duplicate" {{#unless canManageMacro}}disabled{{/unless}}>
          <i class="fas fa-copy"></i> Duplicar
        </button>
        <button type="button" data-action="delete" {{#unless canManageMacro}}disabled{{/unless}}><i class="fas fa-trash"></i> Excluir</button>
        <button type="button" data-action="run"><i class="fas fa-play"></i> Executar</button>
        <button type="button" data-action="save" class="primary" {{#unless canEdit}}disabled{{/unless}}><i class="fas fa-save"></i> Salvar</button>
      </div>
    </header>

    <nav class="macro-maker-editor-nav" role="tablist" aria-label="Modo do editor">
      <button type="button" data-action="show-tab" data-tab="visual" role="tab">
        <i class="fas fa-layer-group"></i> Visual
      </button>
      <button type="button" data-action="show-tab" data-tab="json" role="tab">
        <i class="fas fa-code"></i> JSON avançado
      </button>
      <span class="spacer"></span>
      <button type="button" data-action="undo" title="Desfazer" {{#unless canUndo}}disabled{{/unless}}>
        <i class="fas fa-rotate-left"></i>
      </button>
      <button type="button" data-action="redo" title="Refazer" {{#unless canRedo}}disabled{{/unless}}>
        <i class="fas fa-rotate-right"></i>
      </button>
    </nav>

    <section class="macro-maker-panel macro-maker-visual" data-editor-panel="visual">
      {{#if migrationPending}}<p class="macro-maker-notice"><i class="fas fa-database"></i> Projeto migrado em memória. Salve para persistir a versão atual.</p>{{/if}}
      <fieldset class="macro-maker-project-fields">
        <legend>Projeto</legend>
        <label class="wide">Nome
          <input type="text" value="{{project.name}}" data-project-path="name">
        </label>
        <label class="wide file-field">Imagem do Macro
          <span><input type="text" value="{{project.icon}}" data-project-path="icon"><button type="button" data-action="browse-file" data-project-field="icon" data-file-type="image" title="Selecionar imagem"><i class="fas fa-folder-open"></i></button></span>
        </label>
        <label class="full">Descrição
          <textarea rows="2" data-project-path="description" data-preserve-leading-newline>&#xfeff;{{project.description}}</textarea>
        </label>
      </fieldset>

      {{#if isGM}}
        <fieldset class="macro-maker-project-fields">
          <legend>Compartilhamento</legend>
          <label>Pasta
            <select data-project-path="sharing.folderId" data-value="{{project.sharing.folderId}}"><option value="">Raiz</option>{{#each folders}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
          </label>
          <label>Atribuir a
            <select data-project-path="sharing.userId" data-value="{{project.sharing.userId}}" data-value-type="optional-string"><option value="">Não alterar atribuição</option><option value="*">Todos</option>{{#each users}}<option value="{{id}}">{{name}}{{#unless active}} (offline){{/unless}}</option>{{/each}}</select>
          </label>
          <label>Acesso
            <select data-project-path="sharing.level" data-value="{{project.sharing.level}}" data-value-type="number"><option value="3">OWNER</option><option value="2">OBSERVER</option><option value="0">NONE</option></select>
          </label>
          <label>Slot da sua hotbar <input type="number" min="1" max="50" value="{{project.sharing.hotbarSlot}}" data-project-path="sharing.hotbarSlot" data-value-type="optional-number"></label>
          <label class="checkbox-field"><input type="checkbox" {{#if project.sharing.observerCanExecute}}checked{{/if}} data-project-path="sharing.observerCanExecute" data-value-type="boolean"> OBSERVER pode executar</label>
          <label class="full">Campos bloqueados para não-GM <input type="text" value="{{project.sharing.lockedFields}}" placeholder="targeting, steps" data-project-path="sharing.lockedFields"></label>
        </fieldset>
      {{/if}}

      <fieldset class="macro-maker-project-fields">
        <legend>Seleção e alcance</legend>
        <label>Origem
          <select data-project-path="targeting.source" data-value="{{project.targeting.source}}">
            <option value="controlled">Token controlado</option>
            <option value="none">Sem origem</option>
          </select>
        </label>
        <label>Alvos
          <select data-project-path="targeting.mode" data-value="{{project.targeting.mode}}">
            <option value="currentTargets">Alvos marcados (T)</option>
            <option value="controlled">Outros controlados</option>
            <option value="token">Escolher tokens no canvas</option>
            <option value="point">Escolher ponto</option>
            <option value="circle">Área circular</option>
            <option value="cone">Cone</option>
            <option value="line">Linha</option>
            <option value="template">Template medido selecionado</option>
            <option value="none">Sem alvos</option>
          </select>
        </label>
        <label>Filtro
          <select data-project-path="targeting.filter" data-value="{{project.targeting.filter}}">
            <option value="all">Todos</option>
            <option value="ally">Aliados</option>
            <option value="enemy">Inimigos</option>
          </select>
        </label>
        <label>Mínimo
          <input type="number" min="0" value="{{project.targeting.minTargets}}" data-project-path="targeting.minTargets" data-value-type="number">
        </label>
        <label>Máximo
          <input type="number" min="0" value="{{project.targeting.maxTargets}}" data-project-path="targeting.maxTargets" data-value-type="number">
        </label>
        <label>Alcance
          <input type="number" min="0" step="any" value="{{project.targeting.range}}" placeholder="Sem limite" data-project-path="targeting.range" data-value-type="number-null">
        </label>
        <label>Raio (círculo/cone)
          <input type="number" min="0.1" step="any" value="{{project.targeting.radius}}" data-project-path="targeting.radius" data-value-type="number">
        </label>
        <label>Ângulo do cone
          <input type="number" min="1" max="360" step="any" value="{{project.targeting.angle}}" data-project-path="targeting.angle" data-value-type="number">
        </label>
        <label>Largura da linha
          <input type="number" min="0.1" step="any" value="{{project.targeting.width}}" data-project-path="targeting.width" data-value-type="number">
        </label>
        <label class="checkbox-field">
          <input type="checkbox" {{#if project.targeting.blockOutOfRange}}checked{{/if}} data-project-path="targeting.blockOutOfRange" data-value-type="boolean">
          Bloquear fora do alcance
        </label>        <label class="checkbox-field">
          <input type="checkbox" {{#if project.targeting.clearTargetsAfterExecution}}checked{{/if}} data-project-path="targeting.clearTargetsAfterExecution" data-value-type="boolean">
          Desmarcar alvos ao terminar
        </label>
      </fieldset>

      <fieldset class="macro-maker-project-fields">
        <legend>Variáveis do projeto</legend>
        <p class="full">Defina <strong>FOR = 4</strong> e use <code>1d20 + FOR</code> ou <code>1d20 + @FOR</code>. Para reutilizar dados, crie <strong>DANO</strong> como <em>Fórmula de rolagem</em> com <code>2d6 + FOR</code> e use <code>DANO</code> ou <code>@DANO</code> nos campos de ataque, dano, cura e rolagem. Alterar o valor aqui atualiza todas as fórmulas que o usam.</p>
        <div class="macro-maker-variables full">
          {{#each variables}}
            <div class="macro-maker-variable">
              <label>Nome <input type="text" value="{{name}}" data-variable-name data-variable-index="{{index}}" title="Ex.: FOR ou BONUS. Letras, números e _, sem espaços."></label>
              <label>Tipo <select data-variable-type data-variable-index="{{index}}" data-value="{{valueType}}"><option value="number">Número</option><option value="formula">Fórmula de rolagem</option><option value="string">Texto</option><option value="boolean">Booleano</option><option value="json">Objeto/lista (JSON)</option></select></label>
              <label>Valor <input type="text" value="{{value}}" data-variable-value data-variable-index="{{index}}" title="Número: 4. Fórmula: 2d6 + FOR ou 1d20 + 5. Booleano: true ou false. JSON: [1,2] ou um objeto."></label>
              <button type="button" data-action="delete-variable" data-index="{{index}}" title="Excluir variável"><i class="fas fa-trash"></i></button>
            </div>
          {{else}}<p>Você ainda não definiu variáveis.</p>{{/each}}
        </div>
        <button type="button" data-action="add-variable"><i class="fas fa-plus"></i> Nova variável</button>
      </fieldset>

      <section class="macro-maker-step-builder">
        {{#if debugLog}}
          <details class="macro-maker-debug">
            <summary><i class="fas fa-bug"></i> Explicação da última execução</summary>
            <ol>{{#each debugLog}}<li class="{{#if passed}}passed{{else}}failed{{/if}}"><strong>{{status}}</strong> — {{reason}}</li>{{/each}}</ol>
          </details>
        {{/if}}
        <header class="macro-maker-add-step">
          <h2>Etapas</h2>
          <span class="spacer"></span>
          <label for="macro-maker-step-type">Adicionar</label>
<datalist id="macro-maker-movement-actions">{{#each movementActions}}<option value="{{id}}">{{label}}</option>{{/each}}</datalist>
<datalist id="macro-maker-vision-modes">{{#each visionModes}}<option value="{{id}}">{{label}}</option>{{/each}}</datalist>
<datalist id="macro-maker-light-animations">{{#each lightAnimations}}<option value="{{id}}">{{label}}</option>{{/each}}</datalist>
<datalist id="macro-maker-summon-actors">{{#each summonActors}}<option value="{{name}}">{{id}}</option>{{/each}}</datalist>
                    <select id="macro-maker-step-type" name="newStepType">
            {{#each stepTypes}}<option value="{{type}}">{{label}}</option>{{/each}}
          </select>
          <button type="button" data-action="add-step"><i class="fas fa-plus"></i> Adicionar</button>
        </header>

        <ol class="macro-maker-steps">
          {{#each steps}}
            <li class="macro-maker-step {{#unless isEnabled}}macro-maker-step-disabled{{/unless}}" data-step-index="{{index}}" draggable="true">
              <header class="macro-maker-step-header">
                <i class="fas fa-grip-vertical drag-handle" title="Arraste para reordenar"></i>
                <input class="step-number" type="number" min="1" max="{{../steps.length}}" value="{{number}}" data-step-position="{{index}}" aria-label="Posição da etapa" title="Digite a posição desejada e confirme saindo do campo">
                <span class="step-type">{{type}}</span>
                <label class="step-enabled" title="Etapa habilitada">
                  <input type="checkbox" {{#if isEnabled}}checked{{/if}} data-step-index="{{index}}" data-step-path="enabled" data-value-type="boolean">
                </label>
                <input class="step-label" type="text" value="{{label}}" aria-label="Rótulo da etapa" data-step-index="{{index}}" data-step-path="label">
                <div class="step-actions">
                  <button type="button" data-action="toggle-step" data-index="{{index}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}" title="{{#if collapsed}}Expandir etapa{{else}}Minimizar etapa{{/if}}"><i class="fas fa-chevron-{{#if collapsed}}down{{else}}up{{/if}}"></i></button>
                  <button type="button" data-action="move-step" data-index="{{index}}" data-offset="-1" title="Mover para cima" {{#if isFirst}}disabled{{/if}}><i class="fas fa-arrow-up"></i></button>
                  <button type="button" data-action="move-step" data-index="{{index}}" data-offset="1" title="Mover para baixo" {{#if isLast}}disabled{{/if}}><i class="fas fa-arrow-down"></i></button>
                  <button type="button" data-action="duplicate-step" data-index="{{index}}" title="Duplicar"><i class="fas fa-copy"></i></button>
                  <button type="button" data-action="delete-step" data-index="{{index}}" title="Excluir"><i class="fas fa-trash"></i></button>
                </div>
              </header>

              <div class="macro-maker-step-fields" {{#if collapsed}}hidden{{/if}}>
                <div class="macro-maker-condition-builder full">
                  <header>
                    <strong>Condições da etapa</strong><small class="macro-maker-help-note">Dado natural usa o d20 do último Ataque. Em Crítico, deixe Valor vazio para qualquer crítico; preencha-o (ex.: ≤ 19) para limitar pelo resultado natural.</small>
                    <button type="button" data-action="add-condition" data-index="{{index}}" data-path="conditions"><i class="fas fa-plus"></i> Condição</button>
                    <button type="button" data-action="add-condition" data-index="{{index}}" data-path="conditions" data-condition-kind="group"><i class="fas fa-diagram-project"></i> Grupo</button>
                  </header>
                  {{#each conditionNodes}}
                    <div class="macro-maker-condition-node" style="margin-left: {{indent}}px">
                      <select data-condition-node-type data-step-index="{{../index}}" data-step-path="{{path}}.type" data-value="{{type}}">
                        <option value="critical">Crítico</option><option value="notCritical">Não crítico</option>
                        <option value="hit">Acerto</option><option value="miss">Erro</option>
                        <option value="distance">Distância</option><option value="rollTotal">Total da rolagem</option>
                        <option value="damage">Dano</option><option value="naturalDie">Dado natural</option>
                        <option value="hpPercent">HP percentual</option><option value="hasItem">Possui item</option>
                        <option value="hasEffect">Possui efeito</option><option value="hasTag">Possui tag</option>
                        <option value="targetCount">Quantidade de alvos</option><option value="variable">Variável</option>
                        <option value="menuOption">Opção de menu</option><option value="group">Grupo lógico</option>
                      </select>
                      {{#if isGroup}}
                        <select data-step-index="{{../index}}" data-step-path="{{path}}.operator" data-value="{{operator}}"><option value="and">AND</option><option value="or">OR</option><option value="not">NOT</option></select>
                        <button type="button" data-action="add-condition" data-index="{{../index}}" data-path="{{path}}.children"><i class="fas fa-plus"></i></button>
                      {{else}}
                        <select data-step-index="{{../index}}" data-step-path="{{path}}.operator" data-value="{{operator}}" data-value-type="optional-string"><option value="">Padrão</option><option value="eq">=</option><option value="neq">≠</option><option value="gt">&gt;</option><option value="gte">≥</option><option value="lt">&lt;</option><option value="lte">≤</option><option value="includes">Contém</option></select>
                        <input type="text" value="{{key}}" placeholder="Variável/chave" data-step-index="{{../index}}" data-step-path="{{path}}.key" data-value-type="optional-string">
                        <input type="text" value="{{value}}" placeholder="Valor" data-step-index="{{../index}}" data-step-path="{{path}}.value" data-value-type="optional-string">
                      {{/if}}
                      {{#if deletable}}<button type="button" data-action="delete-condition" data-index="{{../index}}" data-path="{{path}}"><i class="fas fa-trash"></i></button>{{/if}}
                    </div>
                  {{else}}
                    <small>Sem condição: a etapa sempre executa.</small>
                  {{/each}}
                </div>

                <label>Evento
                  <select data-step-index="{{index}}" data-step-path="event" data-value="{{event}}" data-value-type="optional-string">
                    <option value="">Fluxo principal</option>
                    <option value="onStart">Ao iniciar</option>
                    <option value="onTarget">Ao definir alvos</option>
                    <option value="onAttack">Após ataque</option>
                    <option value="onHit">Ao acertar</option>
                    <option value="onMiss">Ao errar</option>
                    <option value="onCritical">No crítico</option>
                    <option value="onDamage">Após dano</option>
                    <option value="onEnd">Ao finalizar</option>
                  </select>
                </label>

                {{#if isAnimation}}
                  <label class="file-field full">Arquivo ou chave Sequencer
                    <span><input type="text" value="{{file}}" data-step-index="{{index}}" data-step-path="file"><button type="button" data-action="browse-file" data-index="{{index}}" data-file-type="video" title="Procurar arquivo"><i class="fas fa-folder-open"></i></button></span>
                  </label>
                  <label>Origem
                    <select data-step-index="{{index}}" data-step-path="source" data-value="{{source}}"><option value="source">Executante</option><option value="target">Alvo</option><option value="location">Ponto escolhido</option><option value="template">Template</option></select>
                  </label>
                  <label>Destino
                    <select data-step-index="{{index}}" data-step-path="target" data-value="{{target}}"><option value="target">Alvo</option><option value="source">Executante</option><option value="location">Ponto escolhido</option><option value="template">Template</option></select>
                  </label>
                  <label>Escala base <input type="number" min="0" step="0.1" value="{{scale}}" data-step-index="{{index}}" data-step-path="scale" data-value-type="optional-number"></label>
                  <label>Escala ao objeto <input type="number" min="0" step="0.1" value="{{scaleToObject}}" data-step-index="{{index}}" data-step-path="scaleToObject" data-value-type="optional-number"></label>
                  <label>Opacidade <input type="number" min="0" max="1" step="0.05" value="{{opacity}}" data-step-index="{{index}}" data-step-path="opacity" data-value-type="optional-number"></label>
                  <label>Cor <input type="text" value="{{tint}}" placeholder="#ffffff" data-step-index="{{index}}" data-step-path="tint"></label>
                  <label>Ajuste de rotação (graus) <input type="number" step="1" value="{{rotation}}" data-step-index="{{index}}" data-step-path="rotation" data-value-type="optional-number"></label>
                  <label>Velocidade <input type="number" min="0.01" step="0.1" value="{{playbackRate}}" data-step-index="{{index}}" data-step-path="playbackRate" data-value-type="optional-number"></label>
                  <label>Fade in (ms) <input type="number" min="0" value="{{fadeIn}}" data-step-index="{{index}}" data-step-path="fadeIn" data-value-type="optional-number"></label>
                  <label>Fade out (ms) <input type="number" min="0" value="{{fadeOut}}" data-step-index="{{index}}" data-step-path="fadeOut" data-value-type="optional-number"></label>
                  <label>Esticar somente após distância <input type="number" min="0" step="any" value="{{distanceBehavior.stretchAfter}}" data-step-index="{{index}}" data-step-path="distanceBehavior.stretchAfter" data-value-type="optional-number"></label>
                  <label>Nome persistente <input type="text" value="{{name}}" data-step-index="{{index}}" data-step-path="name"></label>
                  <div class="checkbox-grid full">
                    <label><input type="checkbox" {{#if attachTo}}checked{{/if}} data-step-index="{{index}}" data-step-path="attachTo" data-value-type="boolean"> Anexar à origem</label>
                    <label><input type="checkbox" {{#if stretchTo}}checked{{/if}} data-step-index="{{index}}" data-step-path="stretchTo" data-value-type="boolean"> Esticar sempre até o destino</label>
                    <label><input type="checkbox" {{#if rotateTowardsTarget}}checked{{/if}} data-step-index="{{index}}" data-step-path="rotateTowardsTarget" data-value-type="boolean"> Apontar para o destino</label>
                    <label><input type="checkbox" {{#if belowTokens}}checked{{/if}} data-step-index="{{index}}" data-step-path="belowTokens" data-value-type="boolean"> Abaixo dos tokens</label>
                    <label><input type="checkbox" {{#if randomRotation}}checked{{/if}} data-step-index="{{index}}" data-step-path="randomRotation" data-value-type="boolean"> Rotação aleatória</label>
                    <label><input type="checkbox" {{#if mirrorX}}checked{{/if}} data-step-index="{{index}}" data-step-path="mirrorX" data-value-type="boolean"> Espelhar X</label>
                    <label><input type="checkbox" {{#if mirrorY}}checked{{/if}} data-step-index="{{index}}" data-step-path="mirrorY" data-value-type="boolean"> Espelhar Y</label>
                    <label><input type="checkbox" {{#if persist}}checked{{/if}} data-step-index="{{index}}" data-step-path="persist" data-value-type="boolean"> Persistente</label>
                  </div>
                  <label>Política ao repetir
                    <select data-step-index="{{index}}" data-step-path="duplicatePolicy" data-value="{{duplicatePolicy}}"><option value="replace">Atualizar/substituir</option><option value="skip">Manter existente</option><option value="stack">Empilhar</option></select>
                  </label>
                  <label>Duração (segundos) <input type="number" min="0" step="any" value="{{durationSeconds}}" data-step-index="{{index}}" data-step-path="durationSeconds" data-value-type="optional-number"></label>
                  <label>Duração (rodadas) <input type="number" min="0" step="any" value="{{durationRounds}}" data-step-index="{{index}}" data-step-path="durationRounds" data-value-type="optional-number"></label>
                  <label>UUID de vínculo <input type="text" value="{{linkUuid}}" placeholder="Token/Actor/Item/ActiveEffect" data-step-index="{{index}}" data-step-path="linkUuid" data-value-type="optional-string"></label>
                  <label class="full">Tags (separadas por vírgula) <input type="text" value="{{tags}}" data-step-index="{{index}}" data-step-path="tags"></label>
                {{/if}}

                {{#if isSound}}
                  <label class="file-field full">Arquivo de áudio
                    <span><input type="text" value="{{file}}" data-step-index="{{index}}" data-step-path="file"><button type="button" data-action="browse-file" data-index="{{index}}" data-file-type="audio"><i class="fas fa-folder-open"></i></button></span>
                  </label>
                  <label>Volume <input type="number" min="0" max="1" step="0.05" value="{{volume}}" data-step-index="{{index}}" data-step-path="volume" data-value-type="optional-number"></label>
                  <label>Fade in (ms) <input type="number" min="0" value="{{fadeIn}}" data-step-index="{{index}}" data-step-path="fadeIn" data-value-type="optional-number"></label>
                  <label>Fade out (ms) <input type="number" min="0" value="{{fadeOut}}" data-step-index="{{index}}" data-step-path="fadeOut" data-value-type="optional-number"></label>
                {{/if}}

                {{#if isAssetPreset}}
                  <fieldset class="macro-maker-integration-settings full">
                    <legend><i class="fas fa-cubes"></i> Asset configurado no Baileywiki Mass Edit</legend>
