<section class="macro-maker-sidebar-content">
  <header class="macro-maker-sidebar-header">
    <div>
      <h2><i class="fas fa-wand-magic-sparkles"></i> Macro Maker</h2>
      <p>Automações visuais</p>
    </div>
    <div class="macro-maker-sidebar-actions">
      <button type="button" data-action="new" title="Criar projeto"><i class="fas fa-plus"></i></button>
    </div>
  </header>

  {{#if isGM}}
    <details class="macro-maker-sidebar-folder-create">
      <summary><i class="fas fa-folder-plus"></i> Nova pasta</summary>
      <div class="macro-maker-folder-create-fields">
        <label>Nome
          <input type="text" name="folderName" placeholder="Ex.: Magias do grupo" required>
        </label>
        <label>Dentro de
          <select name="parentFolderId">
            <option value="">Pasta raiz</option>
            {{#each folderChoices}}<option value="{{id}}">{{name}}</option>{{/each}}
          </select>
        </label>
        <label>Cor
          <input type="color" name="folderColor" value="#58729b" title="Cor da pasta">
        </label>
        <label>Disponibilizar para
          <select name="folderUserId">
            <option value="">Manter somente GM</option>
            <option value="*">Todos os jogadores</option>
            {{#each users}}<option value="{{id}}">{{name}}</option>{{/each}}
          </select>
        </label>
        <label>Nível de acesso
          <select name="folderPermission">
            <option value="3">Dono — pode organizar e editar</option>
            <option value="2">Observador — pode abrir e executar</option>
          </select>
        </label>
      </div>
      <button type="button" data-action="create-folder"><i class="fas fa-check"></i> Criar pasta</button>
    </details>
  {{/if}}

  <ol class="macro-maker-sidebar-projects">
    {{#if isGM}}
      <li class="macro-maker-sidebar-root-drop" data-folder-drop="">
        <i class="fas fa-inbox"></i> Solte aqui para mover à raiz
      </li>
    {{/if}}
    {{#each sidebarEntries}}
      {{#if isFolder}}
        <li class="macro-maker-sidebar-folder" style="--macro-maker-indent: {{indent}}px; --macro-maker-folder-color: {{color}}">
          <article class="macro-maker-sidebar-folder-row" data-folder-drop="{{id}}" data-macro-maker-drag data-entry-kind="folder" data-entry-id="{{id}}" draggable="{{#if canManageFolder}}true{{else}}false{{/if}}">
            {{#if hasChildren}}
              <button type="button" class="macro-maker-folder-toggle" data-action="toggle-folder" data-folder-id="{{id}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}" title="{{#if collapsed}}Abrir pasta{{else}}Fechar pasta{{/if}}">
                <i class="fas fa-chevron-{{#if collapsed}}right{{else}}down{{/if}}" aria-hidden="true"></i>
              </button>
            {{else}}<i class="macro-maker-folder-toggle-spacer" aria-hidden="true"></i>{{/if}}
            <span class="macro-maker-folder-color" title="Cor da pasta"></span>
            <i class="fas fa-folder{{#unless collapsed}}-open{{/unless}}" aria-hidden="true"></i>
            <span class="macro-maker-folder-name" title="{{name}}">{{name}}</span>
            <small title="Quem pode acessar">{{ownership}}</small>
            {{#if canManageFolder}}<button type="button" data-action="configure-folder" data-folder-id="{{id}}" title="Editar nome, cor, pasta e proprietários"><i class="fas fa-gear"></i></button>{{/if}}
          </article>
          {{#if editing}}
            <form class="macro-maker-sidebar-folder-edit" data-folder-id="{{id}}">
              <header><strong>Editar pasta</strong><span>{{ownership}}</span></header>
              <label>Nome <input type="text" name="folderName" value="{{name}}" required></label>
              <label>Dentro de
                <select name="parentFolderId">
                  <option value="">Pasta raiz</option>
                  {{#each folderOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
                </select>
              </label>
              <label>Cor <input type="color" name="folderColor" value="{{color}}"></label>
              <label>Atribuir acesso para
                <select name="folderUserId">
                  <option value="">Não alterar permissões</option>
                  <option value="*">Todos os jogadores</option>
                  {{#each ../users}}<option value="{{id}}">{{name}}</option>{{/each}}
                </select>
              </label>
              <label>Nível de acesso
                <select name="folderPermission">
                  <option value="3">Dono — pode organizar e editar</option>
                  <option value="2">Observador — pode abrir e executar</option>
                  <option value="0">Sem acesso</option>
                </select>
              </label>
              <button type="button" data-action="save-folder"><i class="fas fa-floppy-disk"></i> Salvar pasta</button>
            </form>
          {{/if}}
        </li>
      {{else}}
        <li class="macro-maker-sidebar-project" style="--macro-maker-indent: {{indent}}px" data-macro-maker-drag data-entry-kind="project" data-entry-id="{{uuid}}" draggable="{{#if canManageFolder}}true{{else}}false{{/if}}">
          <i class="fas fa-grip-vertical macro-maker-folder-drag" title="Arraste para outra pasta"></i>
          <img src="{{img}}" alt="">
          <button type="button" class="project-name" data-action="open" data-uuid="{{uuid}}" title="Editar {{name}}">{{name}}</button>
          <button type="button" data-action="run" data-uuid="{{uuid}}" title="Executar {{name}}"><i class="fas fa-play"></i></button>
          {{#if canEdit}}<button type="button" data-action="delete" data-uuid="{{uuid}}" title="Excluir {{name}}"><i class="fas fa-trash"></i></button>{{/if}}
          {{#unless canEdit}}<i class="fas fa-eye" title="Somente leitura"></i>{{/unless}}
        </li>
      {{/if}}
    {{else}}
      <li class="empty">Nenhum projeto ou pasta. Crie sua primeira automação.</li>
    {{/each}}
  </ol>

  {{#if isGM}}
    <section class="macro-maker-persistents">
      <header>
        <h3><i class="fas fa-link"></i> Persistentes ativos</h3>
        <button type="button" data-action="open-persistent-manager" title="Abrir gerenciador do Sequencer"><i class="fas fa-up-right-from-square"></i></button>
      </header>
      <ol>
        {{#each persistents}}
          <li class="{{#if orphan}}orphan{{/if}}">
            <span title="{{name}}">{{label}}</span>
            {{#if orphan}}<i class="fas fa-triangle-exclamation" title="Efeito órfão"></i>{{/if}}
            <button type="button" data-action="end-persistent" data-effect-id="{{id}}" data-effect-name="{{name}}" data-scene-id="{{sceneId}}" title="Encerrar efeito"><i class="fas fa-stop"></i></button>
          </li>
        {{else}}
          <li class="empty">Nenhum efeito do Macro Maker nesta cena.</li>
        {{/each}}
      </ol>
    </section>
  {{/if}}
</section>