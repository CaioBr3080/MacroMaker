<section class="macro-maker-sidebar-content">
  <header class="macro-maker-sidebar-header">
    <div>
      <h2><i class="fas fa-wand-magic-sparkles"></i> Macro Maker</h2>
      <p>Automações visuais</p>
    </div>
    <div class="macro-maker-sidebar-actions">
      {{#if isGM}}<button type="button" data-action="new-folder" title="Criar pasta de Macros e definir permissões"><i class="fas fa-folder-plus"></i></button>{{/if}}
      <button type="button" data-action="new" title="Criar projeto"><i class="fas fa-plus"></i></button>
    </div>
  </header>

  <ol class="macro-maker-sidebar-projects">
    {{#each sidebarEntries}}
      {{#if isFolder}}
        <li class="macro-maker-sidebar-folder" style="--macro-maker-indent: {{indent}}px">
          <i class="fas fa-folder" aria-hidden="true"></i><span>{{name}}</span>
          {{#if canManageFolder}}<button type="button" data-action="configure-folder" data-folder-id="{{id}}" title="Configurar pasta e proprietários"><i class="fas fa-gear"></i></button>{{/if}}
        </li>
      {{else}}
        <li class="macro-maker-sidebar-project" style="--macro-maker-indent: {{indent}}px">
          <img src="{{img}}" alt="">
          <button type="button" class="project-name" data-action="open" data-uuid="{{uuid}}" title="Editar {{name}}">{{name}}</button>
          <button type="button" data-action="run" data-uuid="{{uuid}}" title="Executar {{name}}"><i class="fas fa-play"></i></button>
          {{#if canEdit}}<button type="button" data-action="delete" data-uuid="{{uuid}}" title="Excluir {{name}}"><i class="fas fa-trash"></i></button>{{/if}}
          {{#unless canEdit}}<i class="fas fa-eye" title="Somente leitura"></i>{{/unless}}
        </li>
      {{/if}}
    {{else}}
      <li class="empty">Nenhum projeto. Crie sua primeira automação.</li>
    {{/each}}
  </ol>

  {{#if isGM}}
    <section class="macro-maker-persistents">
      <header>
        <h3><i class="fas fa-link"></i> Persistentes ativos</h3>
        <button type="button" data-action="open-persistent-manager" title="Abrir gerenciador do Sequencer"><i class="fas fa-up-right-from-square"></i></button>
      </header>
      <ol>
        {{#each persistents}}
          <li class="{{#if orphan}}orphan{{/if}}">
            <span title="{{name}}">{{label}}</span>
            {{#if orphan}}<i class="fas fa-triangle-exclamation" title="Efeito órfão"></i>{{/if}}
            <button type="button" data-action="end-persistent" data-effect-id="{{id}}" data-effect-name="{{name}}" data-scene-id="{{sceneId}}" title="Encerrar efeito"><i class="fas fa-stop"></i></button>
          </li>
        {{else}}
          <li class="empty">Nenhum efeito do Macro Maker nesta cena.</li>
        {{/each}}
      </ol>
    </section>
  {{/if}}
</section>
