<section class="macro-maker-manager-content">
  <header class="macro-maker-manager-header">
    <div>
      <h2><i class="fas fa-wand-magic-sparkles"></i> Macro Maker</h2>
      <p>Projetos, pastas e automações visuais</p>
    </div>
    <div class="macro-maker-manager-actions">
      <button type="button" data-action="new-folder" {{#unless isGM}}disabled{{/unless}}><i class="fas fa-folder-plus"></i> Nova pasta</button>
      <button type="button" data-action="new"><i class="fas fa-plus"></i> Novo macro</button>
    </div>
  </header>

  <div class="macro-maker-manager-layout">
    <nav class="macro-maker-manager-tree" aria-label="Projetos e pastas do Macro Maker">
      <header>
        <strong><i class="fas fa-sitemap"></i> Organização</strong>
        <small>Arraste macros ou pastas para reorganizar.</small>
      </header>


      {{#if isGM}}
        <div class="macro-maker-manager-root-drop" data-folder-drop="">
          <i class="fas fa-inbox"></i> Solte aqui para mover à raiz
        </div>
      {{/if}}
      <ol class="macro-maker-manager-entries">
        {{#each managerEntries}}
          {{#if isFolder}}
            <li class="macro-maker-manager-folder" style="--macro-maker-indent: {{indent}}px; --macro-maker-folder-color: {{color}}">
              <article class="macro-maker-manager-folder-row" data-folder-drop="{{id}}" data-macro-maker-drag data-entry-kind="folder" data-entry-id="{{id}}" draggable="{{#if canManageFolder}}true{{else}}false{{/if}}">
                {{#if hasChildren}}
                  <button type="button" class="macro-maker-folder-toggle" data-action="toggle-folder" data-folder-id="{{id}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}" title="{{#if collapsed}}Abrir pasta{{else}}Fechar pasta{{/if}}">
                    <i class="fas fa-chevron-{{#if collapsed}}right{{else}}down{{/if}}"></i>
                  </button>
                {{else}}<i class="macro-maker-folder-toggle-spacer" aria-hidden="true"></i>{{/if}}
                <span class="macro-maker-folder-color" title="Cor da pasta"></span>
                <i class="fas fa-folder{{#unless collapsed}}-open{{/unless}}"></i>
                <span class="macro-maker-manager-entry-name" title="{{name}}">{{name}}</span>
                <small title="Quem pode acessar">{{ownership}}</small>
                {{#if canManageFolder}}<button type="button" data-action="configure-folder" data-folder-id="{{id}}" title="Configurar pasta"><i class="fas fa-gear"></i></button>{{/if}}
              </article>
            </li>
          {{else}}
            <li class="macro-maker-manager-project" style="--macro-maker-indent: {{indent}}px" data-macro-maker-drag data-entry-kind="project" data-entry-id="{{uuid}}" draggable="{{#if canManageOrganization}}true{{else}}false{{/if}}">
              {{#if canManageOrganization}}<i class="fas fa-grip-vertical macro-maker-folder-drag" title="Arraste para outra pasta"></i>{{else}}<i class="macro-maker-folder-toggle-spacer" aria-hidden="true"></i>{{/if}}
              <img src="{{img}}" alt="">
              <button type="button" class="macro-maker-manager-entry-name" data-action="open" data-uuid="{{uuid}}" title="Editar {{name}}">{{name}}</button>
              <button type="button" data-action="run" data-uuid="{{uuid}}" title="Executar {{name}}"><i class="fas fa-play"></i></button>
              {{#if canEdit}}<button type="button" data-action="delete" data-uuid="{{uuid}}" title="Excluir {{name}}"><i class="fas fa-trash"></i></button>{{else}}<i class="fas fa-eye" title="Somente leitura"></i>{{/if}}
            </li>
          {{/if}}
        {{else}}
          <li class="macro-maker-manager-empty"><i class="fas fa-wand-magic-sparkles"></i> Nenhum projeto ou pasta ainda.</li>
        {{/each}}
      </ol>

    </nav>

    <aside class="macro-maker-manager-inspector">
      {{#if isGM}}
        {{#if creatingFolder}}
          <form class="macro-maker-manager-folder-form macro-maker-manager-folder-create">
            <header><div><i class="fas fa-folder-plus"></i><strong> Nova pasta</strong></div><button type="button" data-action="cancel-folder" title="Fechar"><i class="fas fa-xmark"></i></button></header>
            <p>Crie uma pasta, escolha sua cor e defina quem poderá acessá-la.</p>
            <label>Nome <input type="text" name="folderName" placeholder="Ex.: Magias do grupo" required autofocus></label>
            <label>Dentro de
              <select name="parentFolderId"><option value="">Pasta raiz</option>{{#each folderChoices}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
            </label>
            <label>Cor <input type="color" name="folderColor" value="#58729b" title="Cor da pasta"></label>
            <label>Disponibilizar para
              <select name="folderUserId"><option value="">Manter somente GM</option><option value="*">Todos os jogadores</option>{{#each users}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
            </label>
            <label>Nível de acesso
              <select name="folderPermission"><option value="3">Dono — pode organizar e editar</option><option value="2">Observador — pode abrir e executar</option></select>
            </label>
            <footer><button type="button" data-action="create-folder"><i class="fas fa-check"></i> Criar pasta</button></footer>
          </form>
        {{else if editingFolder}}
          <form class="macro-maker-manager-folder-form macro-maker-manager-folder-edit" data-folder-id="{{selectedFolder.id}}">
            <header><div><i class="fas fa-folder-open" style="color: {{selectedFolder.color}}"></i><strong> {{selectedFolder.name}}</strong></div><button type="button" data-action="cancel-folder" title="Fechar"><i class="fas fa-xmark"></i></button></header>
            <p>Cor, localização e permissões desta pasta.</p>
            <label>Nome <input type="text" name="folderName" value="{{selectedFolder.name}}" required></label>
            <label>Dentro de
              <select name="parentFolderId"><option value="">Pasta raiz</option>{{#each selectedFolder.folderOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
            </label>
            <label>Cor <input type="color" name="folderColor" value="{{selectedFolder.color}}"></label>
            <label>Atribuir acesso para
              <select name="folderUserId"><option value="">Não alterar permissões</option><option value="*">Todos os jogadores</option>{{#each users}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
            </label>
            <label>Nível de acesso
              <select name="folderPermission"><option value="3">Dono — pode organizar e editar</option><option value="2">Observador — pode abrir e executar</option><option value="0">Sem acesso</option></select>
            </label>
            <footer><button type="button" data-action="save-folder"><i class="fas fa-floppy-disk"></i> Salvar alterações</button></footer>
          </form>
        {{else}}
          <section class="macro-maker-manager-welcome">
            <i class="fas fa-folder-tree"></i>
            <h3>Organize suas automações</h3>
            <p>Crie uma pasta ou selecione a engrenagem de uma pasta existente para editar nome, cor, localização e acesso.</p>
            <button type="button" data-action="new-folder"><i class="fas fa-folder-plus"></i> Criar pasta</button>
          </section>
        {{/if}}
      {{else}}
        <section class="macro-maker-manager-welcome">
          <i class="fas fa-wand-magic-sparkles"></i>
          <h3>Macros disponíveis</h3>
          <p>Abra um projeto para editar quando tiver permissão, ou use executar para rodar uma automação disponível.</p>
        </section>
      {{/if}}

      <section class="macro-maker-manager-favorites" aria-label="Variáveis frequentes">
        <header>
          <div>
            <strong><i class="fas fa-star"></i> Variáveis frequentes</strong>
            <small>Altere valores dos seus macros sem procurar pelas pastas.</small>
          </div>
          <button type="button" data-action="add-favorite-variable" title="Adicionar variável frequente"><i class="fas fa-plus"></i></button>
        </header>

        {{#if addingFavoriteVariable}}
          <div class="macro-maker-favorite-picker">
            <label>Buscar variável ou macro
              <input type="search" data-favorite-variable-search placeholder="Ex.: FOR ou Ataque flamejante" autocomplete="off">
            </label>
            <ol>
              {{#each favoriteVariableCandidates}}
                <li data-favorite-variable-candidate data-favorite-search-text="{{searchText}}">
                  <button type="button" data-action="add-favorite-variable" data-uuid="{{uuid}}" data-variable-name="{{name}}" title="Adicionar {{name}} de {{macroName}}">
                    <strong>{{name}}</strong> <small>({{macroName}})</small>
                  </button>
                </li>
              {{else}}
                <li class="macro-maker-favorite-empty">Você não tem variáveis editáveis em macros disponíveis.</li>
              {{/each}}
            </ol>
            <button type="button" data-action="cancel-favorite-variable"><i class="fas fa-xmark"></i> Fechar busca</button>
          </div>
        {{/if}}

        <ol class="macro-maker-favorite-list">
          {{#each favoriteVariables}}
            <li data-favorite-variable data-uuid="{{uuid}}" data-variable-name="{{name}}">
              <header>
                <span title="{{name}} em {{macroName}}"><strong>{{name}}</strong> <small>({{macroName}})</small></span>
                <button type="button" data-action="remove-favorite-variable" data-uuid="{{uuid}}" data-variable-name="{{name}}" title="Remover das variáveis frequentes"><i class="fas fa-star"></i></button>
              </header>
              <div class="macro-maker-favorite-edit">
                <input type="text" data-favorite-variable-value value="{{value}}" aria-label="Valor de {{name}}">
                <select data-favorite-variable-type aria-label="Tipo de {{name}}">
                  {{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                <button type="button" data-action="save-favorite-variable" title="Salvar {{name}}"><i class="fas fa-floppy-disk"></i></button>
              </div>
            </li>
          {{else}}
            <li class="macro-maker-favorite-empty">Clique em + para fixar uma variável de um macro que você pode editar.</li>
          {{/each}}
        </ol>
      </section>

      {{#if isGM}}
        <section class="macro-maker-manager-persistents">

          <header><h3><i class="fas fa-link"></i> Persistentes ativos</h3><button type="button" data-action="open-persistent-manager" title="Abrir gerenciador do Sequencer"><i class="fas fa-up-right-from-square"></i></button></header>
          <ol>
            {{#each persistents}}
              <li class="{{#if orphan}}orphan{{/if}}"><span title="{{name}}">{{label}}</span>{{#if orphan}}<i class="fas fa-triangle-exclamation" title="Efeito órfão"></i>{{/if}}<button type="button" data-action="end-persistent" data-effect-id="{{id}}" data-effect-name="{{name}}" data-scene-id="{{sceneId}}" title="Encerrar efeito"><i class="fas fa-stop"></i></button></li>
            {{else}}
              <li class="empty">Nenhum efeito do Macro Maker nesta cena.</li>
            {{/each}}
          </ol>
        </section>
      {{/if}}
    </aside>
  </div>
</section>