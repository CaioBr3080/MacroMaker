{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/macro-maker/project.schema.json",
  "title": "Macro Maker Project",
  "type": "object",
  "required": ["schemaVersion", "name", "targeting", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,128}$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "icon": { "type": "string" },
    "targeting": {
      "type": "object",
      "required": ["source", "mode"],
      "properties": {
        "source": { "enum": ["controlled", "none"] },
        "mode": { "enum": ["currentTargets", "controlled", "token", "point", "circle", "cone", "line", "template", "none"] },
        "filter": { "enum": ["all", "ally", "enemy"] },
        "minTargets": { "type": "integer", "minimum": 0 },
        "maxTargets": { "type": "integer", "minimum": 0 },
        "range": { "type": ["number", "null"] },
        "blockOutOfRange": { "type": "boolean" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "variables": { "type": "object" },
    "sharing": {
      "type": "object",
      "properties": {
        "folderId": { "type": "string" },
        "userId": { "type": "string" },
        "level": { "enum": [0, 2, 3] },
        "observerCanExecute": { "type": "boolean" },
        "hotbarSlot": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
        "lockedFields": { "type": ["array", "string"], "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["animation", "sound", "wait", "attack", "test", "damage", "healing", "roll", "menu", "branch", "setVariable", "mutateSteps", "removePersistent"]
          },
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,128}$" },
          "label": { "type": "string" },
          "enabled": { "type": "boolean" },
          "formula": { "type": "string" },
          "criticalFormula": { "type": "string" },
          "criticalThreshold": { "type": "number", "minimum": 1 },
          "criticalMargin": { "type": "number", "minimum": 0 },
          "criticalMultiplier": { "type": "number", "minimum": 1 },
          "defense": { "type": "number" },
          "defenseKey": { "type": "string" },
          "hitMode": { "enum": ["auto", "manual"] },
          "rollMode": { "enum": ["publicroll", "gmroll", "blindroll", "selfroll"] },
          "event": { "enum": ["onStart", "onTarget", "onAttack", "onHit", "onMiss", "onCritical", "onDamage", "onEnd"] },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["formula"],
              "properties": {
                "formula": { "type": "string", "minLength": 1 },
                "criticalFormula": { "type": "string" },
                "criticalMultiplier": { "type": "number", "minimum": 1 },
                "type": { "type": "string" },
                "flavor": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"]
            }
          },
          "condition": { "type": "object", "required": ["type"] },
          "then": { "type": "array", "items": { "type": "object", "required": ["type"] } },
          "else": { "type": "array", "items": { "type": "object", "required": ["type"] } },
          "options": { "type": "array", "items": { "type": "object", "required": ["label"] } },
          "variable": { "type": "string" },
          "cancelBehavior": { "enum": ["abort", "default", "continue"] },
          "duplicatePolicy": { "enum": ["replace", "skip", "stack"] },
          "durationSeconds": { "type": "number", "minimum": 0 },
          "durationRounds": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
